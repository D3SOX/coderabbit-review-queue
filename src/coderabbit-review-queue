#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail

repo=''
owner=''
name=''
repo_key=''
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=${script_path%/*}
codex_home=${CODEX_HOME:-"$HOME/.codex"}
codex_sessions_root="$codex_home/sessions"
codex_state_db="$codex_home/state_5.sqlite"
claude_home=${CLAUDE_CONFIG_DIR:-${CLAUDE_HOME:-"$HOME/.claude"}}
claude_projects_root="$claude_home/projects"
_claude_agents_json=''
state_root="${XDG_STATE_HOME:-"$HOME/.local/state"}/coderabbit-review-queue"
gui_script="$script_dir/coderabbit-review-queue-gui.py"
monitor_pid_file=''
monitor_lock_file=''
monitor_lock_fd=''
dispatch_lock_file=''
dispatch_lock_fd=''
routed_threads_file=''
queue_order_file=''
quota_expiry_file=''
review_requests_file=''
auto_delegate_file=''
stop_when_empty_file=''
ignore_drafts_file=''
excluded_branches_file=''
excluded_authors_file=''
notify_sound_file=''
notify_sound_path_file=''
notify_sound_volume_file=''
new_items_at_top_file=''
agent_host_file=''
delegated_prs_file=''
delegation_prompt_mode_file=''
delegation_prompt_template_file=''
auto_merge_file=''
merge_method_file=''
delete_branch_file=''
merge_after_delegation_file=''
merge_after_approval_file=''
merge_admin_file=''
archive_after_merge_file=''
archived_heads_file=''
pending_archives_file=''
monitor_state_file=''
review_completion_file=''
snapshot_cache_file=''
snapshot_cache_lock_file=''
quota_remaining=-1
quota_expiry=0
quota_response_attempts=60
quota_retry_delay=120
review_request_window=600
# CodeRabbit minute/hour countdowns are floored (e.g. "20 minutes" can mean
# almost 21), and comment timestamps can lead the internal refill clock.
review_window_safety_seconds=10
review_window_safety_minutes=60
github_quota_threshold=100
github_poll_interval=5
acceptance_response_attempts=36
completion_delay_notice_attempts=120
force_delegation=0
force_local_agents=0
agent_mode_override=''
delegation_prompt_mode_override=''
delegation_prompt_template_override=''
sound_path_override=''
sound_volume_override=''
auto_merge_override=''
merge_method_override=''
delete_branch_override=''
merge_after_delegation_override=''
merge_admin_override=''
empty_announced=0
declare -A attempted_route_threads=()
declare -A completed_review_heads=()
declare -A agent_review_decision_cache=()
deferred_review_count=0

source "$script_dir/lib/notifications.sh"
source "$script_dir/lib/queue-state.sh"
source "$script_dir/lib/reviews.sh"
source "$script_dir/lib/agent-sessions.sh"
source "$script_dir/lib/delegation.sh"
source "$script_dir/lib/agent-progress.sh"
source "$script_dir/lib/merging.sh"
source "$script_dir/lib/cli.sh"

main() {
  local action='run'
  local completed_pr=''
  local selected_repo=''
  local delegate_pr=''
  local excluded_authors=''
  local task_branch=''
  local task_head=''
  local archive_branch=''
  local archive_head=''
  local archive_session=''
  local codex_state_session=''
  local merge_pr='' merge_head='' merge_method_arg='' merge_delete='0' merge_admin_arg='0'

  while (( $# > 0 )); do
    case $1 in
      --repo)
        (( $# >= 2 )) || {
          printf '%s\n' '--repo requires OWNER/NAME.' >&2
          return 2
        }
        selected_repo=$2
        shift 2
        ;;
      --status|--gui|--list-repos|--play-notify-sound|--validate-repo)
        action=${1#--}
        shift
        ;;
      --preview-notify-sound)
        (( $# >= 3 )) && [[ $3 =~ ^[0-9]+$ ]] || {
          printf '%s\n' '--preview-notify-sound requires a path (or empty string) and volume.' >&2
          return 2
        }
        action='preview-notify-sound'
        sound_path_override=$2
        sound_volume_override=$3
        shift 3
        ;;
      --cached-status)
        action='cached-status'
        shift
        ;;
      --set-excluded-authors)
        (( $# >= 2 )) || {
          printf '%s\n' '--set-excluded-authors requires a comma-separated list, or an empty string.' >&2
          return 2
        }
        action='set-excluded-authors'
        excluded_authors=$2
        shift 2
        ;;
      --delegate)
        (( $# >= 2 )) && [[ $2 =~ ^[0-9]+$ ]] || {
          printf '%s\n' '--delegate requires a PR number.' >&2
          return 2
        }
        action='delegate'
        delegate_pr=$2
        shift 2
        ;;
      --delegate-all)
        action='delegate-all'
        shift
        ;;
      --task-progress)
        (( $# >= 3 )) || {
          printf '%s\n' '--task-progress requires a branch and head SHA.' >&2
          return 2
        }
        action='task-progress'
        task_branch=$2
        task_head=$3
        shift 3
        ;;
      --task-id)
        (( $# >= 3 )) || {
          printf '%s\n' '--task-id requires a branch and head SHA.' >&2
          return 2
        }
        action='task-id'
        task_branch=$2
        task_head=$3
        shift 3
        ;;
      --codex-session-state)
        (( $# >= 2 )) || {
          printf '%s\n' '--codex-session-state requires a session ID.' >&2
          return 2
        }
        action='codex-session-state'
        codex_state_session=$2
        shift 2
        ;;
      --archive-task)
        (( $# >= 3 )) || {
          printf '%s\n' '--archive-task requires a branch and head SHA.' >&2
          return 2
        }
        action='archive-task'
        archive_branch=$2
        archive_head=$3
        shift 3
        ;;
      --archive-session)
        (( $# >= 2 )) && [[ $2 =~ ^[0-9a-fA-F-]{36}$ ]] || {
          printf '%s\n' '--archive-session requires a Codex session UUID.' >&2
          return 2
        }
        action='archive-session'
        archive_session=$2
        shift 2
        ;;
      --agent-mode)
        (( $# >= 2 )) && [[ $2 =~ ^(auto|codex|claude)$ ]] || {
          printf '%s\n' '--agent-mode requires auto, codex, or claude.' >&2
          return 2
        }
        agent_mode_override=$2
        shift 2
        ;;
      --local-agents)
        force_local_agents=1
        shift
        ;;
      --merge-now)
        (( $# >= 6 )) && [[ $2 =~ ^[0-9]+$ ]] \
          && [[ $4 =~ ^(merge|squash|rebase)$ ]] && [[ $5 =~ ^[01]$ ]] \
          && [[ $6 =~ ^[01]$ ]] || {
          printf '%s\n' '--merge-now requires PR, head SHA, method, delete flag, and admin flag.' >&2
          return 2
        }
        action='merge-now'
        merge_pr=$2
        merge_head=$3
        merge_method_arg=$4
        merge_delete=$5
        merge_admin_arg=$6
        shift 6
        ;;
      --delegation-prompt-mode)
        (( $# >= 2 )) && [[ $2 =~ ^(default|short|babysit|custom)$ ]] || {
          printf '%s\n' '--delegation-prompt-mode requires default, short, babysit, or custom.' >&2
          return 2
        }
        delegation_prompt_mode_override=$2
        shift 2
        ;;
      --delegation-prompt-template)
        (( $# >= 2 )) || {
          printf '%s\n' '--delegation-prompt-template requires text.' >&2
          return 2
        }
        delegation_prompt_template_override=$2
        shift 2
        ;;
      --auto-merge-setting)
        (( $# >= 6 )) && [[ $2 =~ ^[01]$ ]] \
          && [[ $3 =~ ^(merge|squash|rebase)$ ]] \
          && [[ $4 =~ ^[01]$ ]] && [[ $5 =~ ^(0|1|agent)$ ]] \
          && [[ $6 =~ ^[01]$ ]] || {
          printf '%s\n' '--auto-merge-setting requires enabled, method, delete, post-delegation, and admin values.' >&2
          return 2
        }
        auto_merge_override=$2
        merge_method_override=$3
        delete_branch_override=$4
        merge_after_delegation_override=$5
        merge_admin_override=$6
        shift 6
        ;;
      *)
        printf 'Usage: %s [--repo OWNER/NAME] [--status|--gui|--list-repos|--play-notify-sound|--delegate PR|--set-excluded-authors LIST]\n' "$0" >&2
        return 2
        ;;
    esac
  done

  if [[ $action == gui ]]; then
    show_gui
    return 0
  fi
  if [[ $action == list-repos ]]; then
    list_repositories
    return 0
  fi

  if [[ -z $selected_repo ]]; then
    selected_repo=$(
      gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null
    ) || {
      printf 'Use --repo OWNER/NAME outside a local GitHub checkout.\n' >&2
      return 2
    }
  fi
  configure_repo "$selected_repo"

  if [[ $action == validate-repo ]]; then
    validate_repo
    return $?
  fi

  if [[ $action == task-progress ]]; then
    local_agent_task_progress "$task_branch" "$task_head"
    return 0
  fi
  if [[ $action == task-id ]]; then
    find_codex_session_id "$task_branch" "$task_head"
    return $?
  fi
  if [[ $action == codex-session-state ]]; then
    codex_session_state "$codex_state_session"
    return 0
  fi
  if [[ $action == archive-task ]]; then
    archive_matching_codex_thread "$archive_branch" "$archive_head"
    return $?
  fi
  if [[ $action == archive-session ]]; then
    archive_codex_session_if_idle "$archive_session"
    return $?
  fi
  if [[ $action == merge-now ]]; then
    merge_pr_now "$merge_pr" "$merge_head" "$merge_method_arg" "$merge_delete" "$merge_admin_arg"
    return $?
  fi

  if [[ $action == set-excluded-authors ]]; then
    local temporary
    temporary=$(mktemp "$excluded_authors_file.XXXXXX")
    printf '%s\n' "${excluded_authors//,/$'\n'}" | normalize_authors | jq -r '.[]' >"$temporary"
    mv -- "$temporary" "$excluded_authors_file"
    printf 'Excluded authors saved for %s.\n' "$repo"
    return 0
  fi

  if [[ $action == play-notify-sound ]]; then
    if notify_sound_enabled; then
      play_notification_sound || true
    fi
    return 0
  fi
  if [[ $action == preview-notify-sound ]]; then
    play_notification_sound || true
    return 0
  fi
  if [[ $action == status ]]; then
    show_status
    return $?
  fi
  if [[ $action == cached-status ]]; then
    show_status 60
    return $?
  fi
  if [[ $action == delegate ]]; then
    delegate_pr_now "$delegate_pr"
    return $?
  fi
  if [[ $action == delegate-all ]]; then
    delegate_all_now
    return $?
  fi

  if ! claim_monitor; then
    printf 'A CodeRabbit queue monitor is already running for %s.\n' "$repo" >&2
    return 1
  fi
  trap cleanup_monitor EXIT
  write_monitor_state idle

  # Agent and merge work is independent of CodeRabbit's review quota. Process
  # it once before a cached quota window can put the monitor to sleep.
  state=$(monitor_snapshot)
  route_all_unresolved_async "$state"
  queue_approved_thread_archives "$state"
  merge_approved_reviews "$state"
  process_pending_thread_archives "$state"

  quota_expiry=$(shared_expiry)
  now=$(date -u +%s)
  if (( quota_expiry > now )); then
    write_monitor_state waiting '' '' "$quota_expiry"
    wait_until "$quota_expiry" quiet
  fi

while true; do
  agent_review_decision_cache=()
  state=$(monitor_snapshot)
  route_all_unresolved_async "$state"
  queue_approved_thread_archives "$state"
  merge_approved_reviews "$state"
  process_pending_thread_archives "$state"
  load_stale_rows "$state" 1

  if (( ${#stale[@]} == 0 )); then
    if (( deferred_review_count > 0 )); then
      write_monitor_state waiting '' '' 0
      sleep 30
      continue
    fi
    write_monitor_state idle
    if wait_on_empty_queue; then
      continue
    fi
    exit 0
  fi
  empty_announced=0

  expiry=$(latest_expiry "$state")
  remember_shared_expiry "$expiry"
  quota_expiry=$(shared_expiry)
  (( quota_expiry > expiry )) && expiry=$quota_expiry
  write_monitor_state waiting '' '' "$expiry"
  wait_until "$expiry"

  state=$(monitor_snapshot)
  load_stale_rows "$state" 1
  if (( ${#stale[@]} == 0 )); then
    (( deferred_review_count > 0 )) && continue
    if wait_on_empty_queue; then
      continue
    fi
    exit 0
  fi
  empty_announced=0

  current_expiry=$(latest_expiry "$state")
  now=$(date -u +%s)
  if (( current_expiry > now )); then
    continue
  fi

  claim_dispatch
  IFS=$'\t' read -r quota_pr _updated_at _branch_name _head_sha quota_title _limit_at \
    <<<"${stale[0]}"
  write_monitor_state checking "$quota_pr" "$quota_title"

  state=$(monitor_snapshot)
  load_stale_rows "$state" 1
  if (( ${#stale[@]} == 0 )); then
    release_dispatch
    continue
  fi

  current_expiry=$(latest_expiry "$state")
  quota_expiry=$(shared_expiry)
  (( quota_expiry > current_expiry )) && current_expiry=$quota_expiry
  now=$(date -u +%s)
  if (( current_expiry > now )); then
    release_dispatch
    write_monitor_state waiting '' '' "$current_expiry"
    wait_until "$current_expiry"
    continue
  fi

  IFS=$'\t' read -r quota_pr _updated_at _branch_name _head_sha quota_title _limit_at \
    <<<"${stale[0]}"
  write_monitor_state checking "$quota_pr" "$quota_title"
  if ! query_quota "$quota_pr" "$quota_title"; then
    release_dispatch
    sleep "$quota_retry_delay"
    continue
  fi

  # The quota query can take long enough for the GUI order to change. Reapply
  # the persisted order before choosing which PR receives the available slot.
  agent_review_decision_cache=()
  load_stale_rows "$state" 1
  if (( ${#stale[@]} == 0 )); then
    release_dispatch
    continue
  fi

  if (( quota_remaining == 0 )); then
    now=$(date -u +%s)
    release_dispatch
    if (( quota_expiry > now )); then
      remember_shared_expiry "$quota_expiry"
      write_monitor_state waiting '' '' "$quota_expiry"
      wait_until "$quota_expiry"
      continue
    fi
    printf 'CodeRabbit reported no available reviews without a refill time; retrying in two minutes.\n' >&2
    desktop_notify \
      'CodeRabbit queue waiting' \
      "PR #$quota_pr — $quota_title"$'\n''No refill time was reported. Retrying automatically.'
    sleep "$quota_retry_delay"
    continue
  fi

  row=${stale[0]}
  IFS=$'\t' read -r pr _updated_at branch_name head_sha title _limit_at <<<"$row"

  if ! request_expiry=$(recent_review_request_expiry "$pr" "$head_sha"); then
    printf 'Could not verify recent review requests for PR #%s; retrying in two minutes.\n' \
      "$pr" >&2
    desktop_notify \
      'CodeRabbit duplicate check delayed' \
      "PR #$pr — $title"$'\n''Could not verify recent requests. Retrying in two minutes; no review was triggered.'
    release_dispatch
    sleep "$quota_retry_delay"
    continue
  fi
  now=$(date -u +%s)
  if (( request_expiry > now )); then
    delay=$((request_expiry - now))
    wake=$(human_expiry "$request_expiry")
    printf 'A recent review request already exists for PR #%s; rechecking %s.\n' \
      "$pr" "$wake"
    desktop_notify \
      'CodeRabbit duplicate prevented' \
      "PR #$pr — $title"$'\n'"A review was already requested recently. Rechecking $wake."
    release_dispatch
    sleep "$delay"
    continue
  fi

  if [[ -s $review_completion_file ]]; then
    IFS=$'\t' read -r completed_pr _ <"$review_completion_file"
    [[ $completed_pr != "$pr" ]] || : >"$review_completion_file"
  fi
  write_monitor_state triggering "$pr" "$title"
  printf 'Triggering PR #%s: %s\n' "$pr" "$title"
  desktop_notify \
    'Triggering CodeRabbit review' \
    "PR #$pr — $title"
  triggered_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  record_review_request "$pr" "$head_sha" "$(date -u +%s)"
  if ! gh api -X POST "repos/$repo/issues/$pr/comments" \
    -f body='@coderabbitai review' >/dev/null; then
    printf 'Posting the review request for PR #%s had an uncertain result; retrying safely later.\n' \
      "$pr" >&2
    desktop_notify \
      'CodeRabbit request delayed' \
      "PR #$pr — $title"$'\n''The post result was uncertain. A duplicate guard remains active.'
    release_dispatch
    sleep "$quota_retry_delay"
    continue
  fi

  if wait_for_acceptance "$pr" "$triggered_at" "$head_sha" "$title"; then
    write_monitor_state reviewing "$pr" "$title"
  else
    acceptance_status=$?
    if (( acceptance_status == 2 )); then
      clear_review_request "$pr" "$head_sha"
      state=$(monitor_snapshot)
      remember_shared_expiry "$(latest_expiry "$state")"
      release_dispatch
      continue
    fi
    release_dispatch
    exit "$acceptance_status"
  fi

  if wait_for_review_completion "$pr" "$triggered_at" "$head_sha" "$title"; then
    mark_head_verified "$pr" "$head_sha"
    clear_review_request "$pr" "$head_sha"
  else
    completion_status=$?
    if (( completion_status == 3 )); then
      clear_review_request "$pr" "$head_sha"
      release_dispatch
      continue
    fi
    if (( completion_status == 4 )); then
      write_monitor_state waiting '' '' 0
      release_dispatch
      continue
    fi
    if (( completion_status == 2 )); then
      clear_review_request "$pr" "$head_sha"
      state=$(monitor_snapshot)
      remember_shared_expiry "$(latest_expiry "$state")"
      release_dispatch
      continue
    fi
    release_dispatch
    exit "$completion_status"
  fi
  release_dispatch

  state=$(monitor_snapshot)
  queue_approved_thread_archives "$state"
  merge_approved_reviews "$state"
  process_pending_thread_archives "$state"
  route_all_unresolved_async "$state"
  load_stale_rows "$state" 1
  if (( ${#stale[@]} == 0 )); then
    continue
  fi
done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
