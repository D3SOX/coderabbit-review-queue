claude_session_file() {
  local session_id=$1
  local session_file

  session_file=$(
    find "$claude_projects_root" -mindepth 1 -maxdepth 1 -type d \
      \( -name "*-${name}" -o -name "*-${name}--*" \) \
      -print0 2>/dev/null |
      while IFS= read -r -d '' project_dir; do
        find "$project_dir" -maxdepth 1 -type f -name "${session_id}.jsonl" -print 2>/dev/null
