    [[ -n $session_id && -n $cwd ]] || continue
    [[ -n $timestamp ]] || timestamp='1970-01-01T00:00:00.000Z'

    if [[ $metadata_branch == "$branch_name" ]]; then
      if [[ $timestamp > ${metadata_branch_timestamps[$cwd]:-} ]]; then
        metadata_branch_timestamps["$cwd"]=$timestamp
